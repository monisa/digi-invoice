# ----------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit the real .env.
# On Hostinger, set these in the hPanel Node.js app environment variables.
# ----------------------------------------------------------------------------

# MySQL connection string (Hostinger: mysql://user:pass@host:3306/dbname)
DATABASE_URL="mysql://root:password@localhost:3306/digi_invoice"

# Server
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed CORS origins (Angular dev + prod app domain)
CORS_ORIGINS="http://localhost:6060"

# JWT — use long random strings. Generate e.g.:  openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# bcrypt cost factor
BCRYPT_ROUNDS=10

# SMTP for emailing quotes (optional). If SMTP_HOST is empty, sending is
# skipped and quotes still transition to SENT with the PDF generated.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="no-reply@yourapp.com"
