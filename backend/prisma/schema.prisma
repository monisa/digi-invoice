// =============================================================================
// digi-invoice — Multi-tenant quote management
// Prisma schema (MySQL 8+)
//
// Conventions
//  - Every tenant-owned model carries `tenantId` and is indexed on it. The
//    tenant-scoping Prisma Client extension (src/lib/tenantPrisma.ts) injects
//    this automatically; never trust a tenantId from the request body.
//  - All monetary values use Decimal (mapped to MySQL DECIMAL) — never Float.
//      money      => Decimal @db.Decimal(15, 2)
//      rate/qty   => Decimal @db.Decimal(18, 6)
//      percentage => Decimal @db.Decimal(7, 4)
//  - Financial / audit records use soft delete (`deletedAt`) instead of hard
//    delete, and relations onto them use Restrict to avoid orphaning history.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum TenantPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum UserRole {
  ADMIN
  SALES_MANAGER
  SALES_REP
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SalesOrderStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

// How an overall (quote-level) discount is expressed.
enum DiscountType {
  PERCENT
  AMOUNT
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

model Tenant {
  id              String       @id @default(uuid())
  companyName     String
  subdomain       String       @unique
  plan            TenantPlan   @default(FREE)
  currencyDefault String       @default("USD") @db.Char(3)
  logoPath        String?
  status          TenantStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users          User[]
  accounts       Account[]
  contacts       Contact[]
  deals          Deal[]
  products       Product[]
  taxRates       TaxRate[]
  quoteTemplates QuoteTemplate[]
  quotes         Quote[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  exchangeRates  ExchangeRate[]
  quoteSequences QuoteNumberSequence[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid())
  tenantId     String
  name         String
  email        String
  passwordHash String
  role         UserRole   @default(SALES_REP)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens      RefreshToken[]
  ownedQuotes        Quote[]            @relation("QuoteOwner")
  approvalsRequested QuoteApproval[]    @relation("ApprovalRequestedBy")
  approvalsToAct     QuoteApproval[]    @relation("ApprovalApprover")
  activityLogs       QuoteActivityLog[]

  // Email is unique per-tenant, not globally.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Optional granular RBAC layer beyond the fixed roles. Seed per-tenant or
// globally (tenantId nullable => global default for a role).
model Permission {
  id            String   @id @default(uuid())
  tenantId      String?
  role          UserRole
  permissionKey String

  @@unique([tenantId, role, permissionKey])
  @@index([tenantId])
  @@map("permissions")
}

// ---------------------------------------------------------------------------
// CRM mini-module
// ---------------------------------------------------------------------------

model Account {
  id              String    @id @default(uuid())
  tenantId        String
  name            String
  industry        String?
  website         String?
  billingAddress  String?   @db.Text
  shippingAddress String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts Contact[]
  deals    Deal[]
  quotes   Quote[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@map("accounts")
}

model Contact {
  id        String    @id @default(uuid())
  tenantId  String
  accountId String?
  name      String
  email     String?
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  quotes  Quote[]

  @@index([tenantId])
  @@index([accountId])
  @@map("contacts")
}

model Deal {
  id                String    @id @default(uuid())
  tenantId          String
  accountId         String?
  name              String
  stage             DealStage @default(PROSPECTING)
  amount            Decimal?  @db.Decimal(15, 2)
  currency          String    @default("USD") @db.Char(3)
  expectedCloseDate DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  quotes  Quote[]

  @@index([tenantId])
  @@index([accountId])
  @@index([tenantId, stage])
  @@map("deals")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model TaxRate {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  percentage Decimal   @db.Decimal(7, 4)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]
  lineItems QuoteLineItem[]

  @@index([tenantId])
  @@map("tax_rates")
}

model Product {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  sku         String?
  unitPrice   Decimal   @db.Decimal(15, 2)
  currency    String    @default("USD") @db.Char(3)
  taxRateId   String?
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxRate   TaxRate?        @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  lineItems QuoteLineItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Quoting
// ---------------------------------------------------------------------------

model QuoteTemplate {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  headerHtml String?   @db.Text
  footerHtml String?   @db.Text
  termsHtml  String?   @db.Text
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotes Quote[]

  @@index([tenantId])
  @@map("quote_templates")
}

model Quote {
  id            String      @id @default(uuid())
  tenantId      String
  quoteNumber   String
  accountId     String?
  contactId     String?
  dealId        String?
  templateId    String?
  ownerId       String?
  status        QuoteStatus @default(DRAFT)
  currency      String      @default("USD") @db.Char(3)
  exchangeRate  Decimal     @default(1) @db.Decimal(18, 6)
  // Overall (quote-level) discount applied after line-level discounts.
  overallDiscountType  DiscountType @default(PERCENT)
  overallDiscountValue Decimal      @default(0) @db.Decimal(15, 4)
  // Server-computed totals (decimal.js); never trusted from the client.
  subtotal      Decimal     @default(0) @db.Decimal(15, 2)
  discountTotal Decimal     @default(0) @db.Decimal(15, 2)
  taxTotal      Decimal     @default(0) @db.Decimal(15, 2)
  grandTotal    Decimal     @default(0) @db.Decimal(15, 2)
  validUntil    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account  Account?       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  contact  Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal     Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  template QuoteTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  owner    User?          @relation("QuoteOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  lineItems   QuoteLineItem[]
  approvals   QuoteApproval[]
  signatures  QuoteSignature[]
  activityLog QuoteActivityLog[]
  salesOrders SalesOrder[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@index([accountId])
  @@map("quotes")
}

model QuoteLineItem {
  id          String  @id @default(uuid())
  quoteId     String
  productId   String?
  taxRateId   String?
  description String? @db.Text
  quantity    Decimal @default(1) @db.Decimal(18, 6)
  unitPrice   Decimal @db.Decimal(15, 2)
  discountPct Decimal @default(0) @db.Decimal(7, 4)
  lineTotal   Decimal @default(0) @db.Decimal(15, 2)
  position    Int     @default(0)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_line_items")
}

model QuoteApproval {
  id          String         @id @default(uuid())
  quoteId     String
  requestedBy String
  approverId  String?
  status      ApprovalStatus @default(PENDING)
  comments    String?        @db.Text
  createdAt   DateTime       @default(now())
  actedAt     DateTime?

  quote     Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  requester User  @relation("ApprovalRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  approver  User? @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([approverId, status])
  @@map("quote_approvals")
}

model QuoteSignature {
  id                 String    @id @default(uuid())
  quoteId            String
  signerName         String
  signerEmail        String?
  signatureImagePath String?
  ipAddress          String?
  publicToken        String    @unique
  signedAt           DateTime?
  createdAt          DateTime  @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_signatures")
}

// Append-only audit trail. Never updated or deleted.
model QuoteActivityLog {
  id          String   @id @default(uuid())
  quoteId     String
  userId      String?
  action      String
  detailsJson Json?
  createdAt   DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_activity_logs")
}

// ---------------------------------------------------------------------------
// Conversion
// ---------------------------------------------------------------------------

model SalesOrder {
  id          String           @id @default(uuid())
  tenantId    String
  quoteId     String?
  orderNumber String
  status      SalesOrderStatus @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote    Quote?    @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@map("sales_orders")
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  salesOrderId  String?
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Currency
// ---------------------------------------------------------------------------

model ExchangeRate {
  id             String   @id @default(uuid())
  tenantId       String
  baseCurrency   String   @db.Char(3)
  targetCurrency String   @db.Char(3)
  rate           Decimal  @db.Decimal(18, 6)
  effectiveDate  DateTime
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, baseCurrency, targetCurrency, effectiveDate])
  @@index([tenantId])
  @@map("exchange_rates")
}

// Per-tenant atomic counter backing sequential quote numbers
// (e.g. QT-2026-00001). One row per (tenant, prefix, year).
model QuoteNumberSequence {
  id        String @id @default(uuid())
  tenantId  String
  prefix    String @default("QT")
  year      Int
  lastValue Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, prefix, year])
  @@index([tenantId])
  @@map("quote_number_sequences")
}
