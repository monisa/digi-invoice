APP_NAME=digi-invoice
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL connection (Hostinger: host is usually a srv####.hostinger.com hostname,
# not literally "localhost" — check hPanel > Databases > MySQL Databases).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digi_invoice
DB_USERNAME=root
DB_PASSWORD=

# Stateless JSON API — no server-side sessions, no queued jobs, no DB cache
# table needed, so these stay off the "database" driver on purpose.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

# JWT — use long random strings, e.g. `openssl rand -base64 48`.
# On Hostinger, set these (and everything below) in hPanel's environment
# variables / .env on the server, never commit real values.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_MINUTES=10080

# Comma-separated list of allowed CORS origins (Angular dev + prod app domain)
CORS_ALLOWED_ORIGINS=http://localhost:6060

# SMTP for emailing quotes (optional). With MAIL_MAILER=log, mail is written
# to the log instead of sent — quotes still transition to SENT with the PDF
# generated regardless. Set MAIL_MAILER=smtp + the SMTP_* vars in production.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@digi-invoice.local"
MAIL_FROM_NAME="${APP_NAME}"
